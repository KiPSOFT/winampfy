{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winampfy",
  "version": "0.1.17",
  "identifier": "com.serkankocaman.winampfy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Winampfy",
        "width": 275,
        "height": 116,
        "minWidth": 275,
        "minHeight": 14,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "equalizer",
        "title": "Winampfy Equalizer",
        "url": "index.html?role=equalizer",
        "width": 275,
        "height": 116,
        "minWidth": 275,
        "minHeight": 14,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "playlist",
        "title": "Winampfy Playlist Editor",
        "url": "index.html?role=playlist",
        "width": 275,
        "height": 232,
        "minWidth": 275,
        "minHeight": 116,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "milkdrop",
        "title": "Winampfy Milkdrop",
        "url": "index.html?role=milkdrop",
        "width": 550,
        "height": 406,
        "minWidth": 275,
        "minHeight": 116,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "dialogs",
        "title": "Winampfy",
        "url": "index.html?role=dialogs",
        "width": 560,
        "height": 480,
        "minWidth": 360,
        "minHeight": 184,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDdFMkMwOUREN0Y4MTlFQTIKUldTaW5vRi8zUWtzZnFtdmxmMGpSWVYxZnlrS2FFeElJNjFsUkxvSzRLOGFCY2o4eG1JK09KVlAK",
      "endpoints": [
        "https://github.com/KiPSOFT/winampfy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
