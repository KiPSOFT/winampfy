{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winampfy",
  "version": "0.1.9",
  "identifier": "com.serkankocaman.winampfy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Winampfy",
        "width": 550,
        "height": 406,
        "minWidth": 550,
        "minHeight": 406,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDdFMkMwOUREN0Y4MTlFQTIKUldTaW5vRi8zUWtzZnFtdmxmMGpSWVYxZnlrS2FFeElJNjFsUkxvSzRLOGFCY2o4eG1JK09KVlAK",
      "endpoints": [
        "https://github.com/KiPSOFT/winampfy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
